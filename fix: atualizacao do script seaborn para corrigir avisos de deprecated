        "# Bloco 2: Ingestão de Dados com PySpark\n",
        "caminho_arquivo = \"/content/drive/MyDrive/Sistematizacao_CD2/application_train.csv\"\n",
        "\n",
        "# Carregando o dataset. O inferSchema=True faz o Spark descobrir sozinho se a coluna é texto ou número.\n",
        "df = spark.read.csv(caminho_arquivo, header=True, inferSchema=True)\n",
        "\n",
        "# Exibindo o tamanho real da base para comprovar o volume de dados\n",
        "linhas = df.count()\n",
        "colunas = len(df.columns)\n",
        "\n",
        "print(f\"Total de registros carregados: {linhas}\")\n",
        "print(f\"Total de atributos (colunas): {colunas}\")\n",
        "\n",
        "# Mostrando as 5 primeiras linhas para validação visual\n",
        "df.show(5)"
      ]
