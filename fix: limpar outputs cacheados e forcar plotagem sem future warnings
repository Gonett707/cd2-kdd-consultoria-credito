        "    ORDER BY Taxa_Inadimplencia DESC\n",
        "    LIMIT 5\n",
        "\"\"\")\n",
        "df_q3 = q3.toPandas()\n",
        "display(df_q3)\n",
        "# CORREÇÃO APLICADA AQUI (com hue e legend=False)\n",
        "sns.barplot(data=df_q3, y='Ocupacao', x='Taxa_Inadimplencia', hue='Ocupacao', legend=False, ax=axes[1,0], palette='Oranges_r')\n",
        "axes[1,0].set_title('Top 5 Profissões de Risco (%)', fontweight='bold')\n",
        "print(\"Insight: Trabalhadores braçais (Low-skill Laborers) e motoristas apresentam as maiores taxas de default. Essa métrica sinaliza onde as travas do motor de aprovação automática precisam ser mais rigorosas.\\n\")\n",
        "\n",
        "# PERGUNTA 4: O número de filhos afeta a capacidade de pagamento?\n",
        "print(\"4. Inadimplência pela Quantidade de Filhos:\")\n",
        "q4 = spark.sql(\"\"\"\n",
