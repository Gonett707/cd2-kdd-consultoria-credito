        "# Bloco 4: Análise Exploratória com Spark SQL e Visualização\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from IPython.display import display\n",
        "\n",
        "# 1. Criando a view temporária no Spark para rodar as consultas SQL\n",
        "df_limpo.createOrReplaceTempView(\"tb_credito\")\n",
        "\n",
        "# 2. Configurando o layout executivo para os gráficos\n",
        "sns.set_theme(style=\"darkgrid\")\n",
        "fig, axes = plt.subplots(3, 2, figsize=(16, 18))\n",
        "fig.tight_layout(pad=6.0)\n",
        "fig.delaxes(axes[2,1]) # Removendo o sexto espaço vazio\n",
        "\n",
        "print(\"--- INICIANDO ANÁLISE EXPLORATÓRIA (5 PERGUNTAS DE NEGÓCIO) ---\\n\")\n",
        "\n",
        "# PERGUNTA 1: Qual a taxa de inadimplência média por gênero?\n",
        "print(\"1. Inadimplência por Gênero:\")\n",
        "q1 = spark.sql(\"\"\"\n",
        "    SELECT CODE_GENDER as Genero,\n",
        "           COUNT(*) as Total_Clientes,\n",
        "           AVG(TARGET) * 100 as Taxa_Inadimplencia\n",
        "    FROM tb_credito\n",
        "    WHERE CODE_GENDER IN ('M', 'F')\n",
        "    GROUP BY CODE_GENDER\n",
        "    ORDER BY Taxa_Inadimplencia DESC\n",
        "\"\"\")\n",
        "df_q1 = q1.toPandas()\n",
        "display(df_q1)\n",
        "# CORREÇÃO APLICADA AQUI (com hue e legend=False)\n",
        "sns.barplot(data=df_q1, x='Genero', y='Taxa_Inadimplencia', hue='Genero', legend=False, ax=axes[0,0], palette='Blues_r')\n",
        "axes[0,0].set_title('Inadimplência por Gênero (%)', fontweight='bold')\n",
        "print(\"Insight: Os dados apontam que homens (M) apresentam um risco de quebra consideravelmente maior que mulheres (F) no histórico da carteira.\\n\")\n",
        "\n",
        "# PERGUNTA 2: Como o nível de escolaridade impacta a taxa de inadimplência?\n",
        "print(\"2. Inadimplência por Escolaridade:\")\n",
        "q2 = spark.sql(\"\"\"\n",
        "    SELECT NAME_EDUCATION_TYPE as Nivel_Educacao,\n",
        "           COUNT(*) as Total,\n",
        "           AVG(TARGET) * 100 as Taxa_Inadimplencia\n",
        "    FROM tb_credito\n",
        "    GROUP BY NAME_EDUCATION_TYPE\n",
        "    ORDER BY Taxa_Inadimplencia DESC\n",
        "\"\"\")\n",
        "df_q2 = q2.toPandas()\n",
        "display(df_q2)\n",
        "# CORREÇÃO APLICADA AQUI (com hue e legend=False)\n",
        "sns.barplot(data=df_q2, y='Nivel_Educacao', x='Taxa_Inadimplencia', hue='Nivel_Educacao', legend=False, ax=axes[0,1], palette='Reds_r')\n",
        "axes[0,1].set_title('Inadimplência por Escolaridade (%)', fontweight='bold')\n",
        "print(\"Insight: Existe uma forte correlação inversa. Clientes com nível secundário (Secondary) lideram o risco, enquanto os com grau acadêmico superior (Academic degree) formam o perfil mais conservador e seguro.\\n\")\n",
        "\n",
        "# PERGUNTA 3: Qual o volume de crédito e risco das 5 profissões mais críticas?\n",
        "print(\"3. Top 5 Ocupações de Maior Risco:\")\n",
        "q3 = spark.sql(\"\"\"\n",
        "    SELECT OCCUPATION_TYPE as Ocupacao,\n",
        "           COUNT(*) as Total_Clientes,\n",
        "           SUM(AMT_CREDIT)/1000000 as Vol_Credito_Milhoes,\n",
        "           AVG(TARGET) * 100 as Taxa_Inadimplencia\n",
        "    FROM tb_credito\n",
        "    WHERE OCCUPATION_TYPE != 'Nao_Informado'\n",
