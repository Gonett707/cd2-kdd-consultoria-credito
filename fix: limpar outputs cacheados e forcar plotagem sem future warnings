        "# Bloco 3: Limpeza de Dados e Tratamento de Nulos\n",
        "from pyspark.sql.functions import col, when, isnan, count\n",
        "\n",
        "# 1. Contagem de nulos inteligente (evita erro de conversão em colunas de texto)\n",
        "exprs = [\n",
        "    count(when(isnan(col(c)) | col(c).isNull(), c)).alias(c) if t in ['double', 'float']\n",
        "    else count(when(col(c).isNull(), c)).alias(c)\n",
        "    for c, t in df.dtypes\n",
        "]\n",
        "\n",
        "df_nulos = df.select(*exprs).collect()[0].asDict()\n",
        "\n",
        "total_linhas = df.count()\n",
        "\n",
        "# 2. Regra de negócio: Descartar colunas com mais de 50% de dados ausentes\n",
        "colunas_para_remover = [c for c, nulos in df_nulos.items() if (nulos / total_linhas) > 0.5]\n",
        "print(f\"Colunas com mais de 50% de dados faltantes (serão descartadas): {len(colunas_para_remover)}\")\n",
        "\n",
        "df_limpo = df.drop(*colunas_para_remover)\n",
        "\n",
        "# 3. Tratamento dos nulos restantes e tipagem\n",
        "tipos = dict(df_limpo.dtypes)\n",
        "colunas_numericas = [c for c, t in tipos.items() if t in ['int', 'double', 'float', 'bigint']]\n",
        "colunas_categoricas = [c for c, t in tipos.items() if t == 'string']\n",
        "\n",
        "# Imputação prática: substituímos nulos numéricos por 0 e textos vazios por 'Nao_Informado'\n",
        "df_limpo = df_limpo.fillna(0, subset=colunas_numericas)\n",
        "df_limpo = df_limpo.fillna('Nao_Informado', subset=colunas_categoricas)\n",
        "\n",
        "# 4. Remoção de registros duplicados\n",
        "df_limpo = df_limpo.dropDuplicates()\n",
        "\n",
        "print(f\"Total de colunas (features) restantes para a análise: {len(df_limpo.columns)}\")\n",
        "print(\"Limpeza e tipagem concluídas com sucesso!\")"
      ]
