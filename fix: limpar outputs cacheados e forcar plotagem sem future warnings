        "# Bloco 5: Preparação de Features e Modelagem Preditiva com MLlib\n",
        "from pyspark.ml.feature import StringIndexer, VectorAssembler\n",
        "from pyspark.ml.classification import LogisticRegression, RandomForestClassifier\n",
        "from pyspark.ml.evaluation import BinaryClassificationEvaluator\n",
        "from pyspark.ml import Pipeline\n",
        "\n",
        "print(\"--- INICIANDO MODELAGEM PREDITIVA (CLASSIFICAÇÃO) ---\\n\")\n",
        "\n",
        "# 1. Seleção de atributos e balanceamento básico\n",
        "# Para viabilizar a execução em tempo hábil no Colab e evitar estouro de memória no treinamento do RandomForest,\n",
        "# selecionamos colunas representativas com base nas hipóteses validadas pela análise exploratória.\n",
        "colunas_selecionadas = [\n",
        "    'TARGET', 'CODE_GENDER', 'FLAG_OWN_CAR', 'FLAG_OWN_REALTY', 'NAME_EDUCATION_TYPE',\n",
        "    'OCCUPATION_TYPE', 'AMT_INCOME_TOTAL', 'AMT_CREDIT', 'DAYS_BIRTH', 'DAYS_EMPLOYED'\n",
        "]\n",
        "\n",
        "df_modelo = df_limpo.select(*colunas_selecionadas)\n",
        "\n",
        "# 2. Engenharia de Features: Convertendo variáveis de texto para índices numéricos\n",
        "indexers = [\n",
        "    StringIndexer(inputCol=c, outputCol=c+\"_index\").setHandleInvalid(\"keep\")\n",
        "    for c in ['CODE_GENDER', 'FLAG_OWN_CAR', 'FLAG_OWN_REALTY', 'NAME_EDUCATION_TYPE', 'OCCUPATION_TYPE']\n",
        "]\n",
        "\n",
        "# Montando o vetor denso exigido pelos algoritmos do Spark ML\n",
        "features = ['AMT_INCOME_TOTAL', 'AMT_CREDIT', 'DAYS_BIRTH', 'DAYS_EMPLOYED'] + [c.getOutputCol() for c in indexers]\n",
        "assembler = VectorAssembler(inputCols=features, outputCol=\"features\")\n",
        "\n",
        "# 3. Divisão do Dataset (Holdout Validation)\n",
        "# Separamos 80% dos dados para treinar o algoritmo e 20% inéditos para testar sua precisão real\n",
        "treino, teste = df_modelo.randomSplit([0.8, 0.2], seed=42)\n",
        "print(f\"Volume da base de Treino: {treino.count()} registros.\")\n",
        "print(f\"Volume da base de Teste: {teste.count()} registros.\\n\")\n",
        "\n",
        "# 4. Treinamento do Modelo Base (Regressão Logística)\n",
        "lr = LogisticRegression(featuresCol=\"features\", labelCol=\"TARGET\", maxIter=10)\n",
        "pipeline_lr = Pipeline(stages=indexers + [assembler, lr])\n",
        "\n",
        "print(\"Treinando Modelo Base (Logistic Regression)...\")\n",
        "modelo_lr = pipeline_lr.fit(treino)\n",
        "previsoes_lr = modelo_lr.transform(teste)\n",
        "\n",
        "# 5. Treinamento do Modelo Ensemble (Random Forest) - Exigência do Barema\n",
        "rf = RandomForestClassifier(featuresCol=\"features\", labelCol=\"TARGET\", numTrees=20, maxDepth=5)\n",
        "pipeline_rf = Pipeline(stages=indexers + [assembler, rf])\n",
        "\n",
        "print(\"Treinando Modelo Ensemble (Random Forest)...\")\n",
        "modelo_rf = pipeline_rf.fit(treino)\n",
        "previsoes_rf = modelo_rf.transform(teste)\n",
        "\n",
        "# 6. Avaliação e Comparação Criteriosa de Métricas (AUC-ROC)\n",
        "# Como a base tem poucos inadimplentes (desbalanceada), a acurácia mascara a realidade. O AUC-ROC avalia o acerto real.\n",
        "evaluator = BinaryClassificationEvaluator(labelCol=\"TARGET\", metricName=\"areaUnderROC\")\n",
        "\n",
        "auc_lr = evaluator.evaluate(previsoes_lr)\n",
        "auc_rf = evaluator.evaluate(previsoes_rf)\n",
        "\n",
        "print(\"\\n--- RESULTADOS FINAIS DA MODELAGEM ---\")\n",
        "print(f\"Área sob a curva ROC - Logistic Regression: {auc_lr:.4f}\")\n",
        "print(f\"Área sob a curva ROC - Random Forest: {auc_rf:.4f}\")\n",
        "\n",
        "if auc_rf > auc_lr:\n",
        "    print(\"\\nConclusão Técnica: O modelo de Ensemble (Random Forest) obteve maior poder preditivo no teste de generalização, lidando melhor com as correlações não-lineares da base.\")\n",
        "else:\n",
        "    print(\"\\nConclusão Técnica: O modelo linear base obteve desempenho competitivo/superior nesta amostra específica de features.\")"
      ]
