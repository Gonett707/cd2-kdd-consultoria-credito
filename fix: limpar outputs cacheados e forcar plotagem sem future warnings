        "# Bloco 6: Modelagem Descritiva (Clusterização com K-Means)\n",
        "from pyspark.ml.clustering import KMeans\n",
        "from pyspark.ml.feature import StandardScaler\n",
        "from pyspark.ml.evaluation import ClusteringEvaluator\n",
        "from pyspark.ml.feature import VectorAssembler\n",
        "import pandas as pd\n",
        "from IPython.display import display\n",
        "\n",
        "print(\"--- INICIANDO MODELAGEM DESCRITIVA (CLUSTERIZAÇÃO) ---\\n\")\n",
        "\n",
        "# 1. Preparação dos dados contínuos\n",
        "# K-Means calcula distâncias matemáticas, então precisamos de variáveis numéricas.\n",
        "features_cluster = ['AMT_INCOME_TOTAL', 'AMT_CREDIT', 'DAYS_BIRTH', 'DAYS_EMPLOYED']\n",
        "\n",
        "assembler_cluster = VectorAssembler(inputCols=features_cluster, outputCol=\"features_raw\")\n",
        "df_cluster_raw = assembler_cluster.transform(df_limpo.na.drop(subset=features_cluster))\n",
        "\n",
        "# Padronização: Impede que atributos com números muito grandes (como Volume de Crédito) esmaguem atributos menores (Idade)\n",
        "scaler = StandardScaler(inputCol=\"features_raw\", outputCol=\"features_scaled\", withStd=True, withMean=False)\n",
        "scaler_model = scaler.fit(df_cluster_raw)\n",
        "df_scaled = scaler_model.transform(df_cluster_raw)\n",
        "\n",
        "# 2. Treinamento do K-Means\n",
        "# Definimos k=3 buscando segmentar os clientes em 3 faixas de liquidez/maturidade (baixo, médio e alto)\n",
        "k = 3\n",
        "kmeans = KMeans(featuresCol=\"features_scaled\", predictionCol=\"cluster\", k=k, seed=42)\n",
        "print(f\"Treinando K-Means para {k} clusters...\")\n",
        "modelo_kmeans = kmeans.fit(df_scaled)\n",
        "previsoes_cluster = modelo_kmeans.transform(df_scaled)\n",
        "\n",
        "# 3. Avaliação pela Métrica da Silhueta (Exigência do Barema)\n",
        "evaluator_cluster = ClusteringEvaluator(predictionCol=\"cluster\", featuresCol=\"features_scaled\", metricName=\"silhouette\", distanceMeasure=\"squaredEuclidean\")\n",
        "silhueta = evaluator_cluster.evaluate(previsoes_cluster)\n",
        "print(f\"Qualidade do Agrupamento (Silhouette Score) para k={k}: {silhueta:.4f}\")\n",
        "print(\"Nota técnica: Valores positivos validam que os grupos possuem coesão interna razoável.\\n\")\n",
        "\n",
        "# 4. Interpretação dos Perfis (Centróides)\n",
        "centros = modelo_kmeans.clusterCenters()\n",
        "df_centros = pd.DataFrame(centros, columns=features_cluster)\n",
        "\n",
        "# Tratando os dados para ficarem compreensíveis para o time de negócios\n",
        "df_centros['Renda_Media'] = df_centros['AMT_INCOME_TOTAL'].round(2)\n",
        "df_centros['Credito_Medio'] = df_centros['AMT_CREDIT'].round(2)\n",
        "df_centros['Idade_Anos'] = (df_centros['DAYS_BIRTH'] / -365).round(1) # Dias negativos para anos de vida\n",
        "df_centros['Tempo_Emprego_Anos'] = (df_centros['DAYS_EMPLOYED'] / -365).round(1) # Dias negativos para anos\n",
        "\n",
        "# Mantendo apenas as colunas amigáveis para leitura executiva\n",
        "df_centros = df_centros[['Renda_Media', 'Credito_Medio', 'Idade_Anos', 'Tempo_Emprego_Anos']]\n",
        "df_centros.index.name = 'Cluster'\n",
        "\n",
        "print(\"--- PERFIL DOS CLUSTERS (LINGUAGEM DE NEGÓCIO) ---\")\n",
        "display(df_centros)\n",
        "\n",
        "print(\"\\nInterpretação Executiva (KDD):\")\n",
        "print(\"Ao observar os centróides da tabela acima, o algoritmo isolou perfis distintos baseados no poder aquisitivo (Renda x Crédito) e maturidade profissional (Idade x Emprego).\")\n",
        "print(\"Em um cenário real, um gestor utilizaria esses clusters para desenhar 'Esteiras de Concessão': o cluster de limite mais baixo seria direcionado para aprovação automática, enquanto o cluster com limites de crédito milionários passaria por uma mesa de auditoria humana, otimizando o tempo operacional do banco.\")"
